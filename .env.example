# Copy to .env.local for local development (gitignored).
# For production, set GitHub Actions repository variables with the same
# names — see docs/AUTH.md and docs/BACKEND.md.
# Everything below is public-by-design (ships in the JS bundle); RLS and
# OAuth origin checks are the actual security boundaries. No secrets here.

# Google OAuth client id (client-side GIS fallback flow)
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# Supabase project (data backbone: shared state, geo queries, realtime).
# When set, Google sign-in routes through Supabase Auth instead of GIS.
# Project settings → API: https://supabase.com/dashboard
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# CARTO basemaps key → the Dark Matter basemap (free within CARTO's fair use
# of 5M tiles/month; domain-restricted; no CARTO account needed).
# Request one at https://carto.com/basemaps/apikey — it arrives by email.
# Unset = keyless OpenStreetMap tiles with a client-side dark filter.
VITE_CARTO_KEY=
